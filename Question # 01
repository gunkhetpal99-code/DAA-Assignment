import java.util.*;

public class Graph {
    public static void main(String[] args) {

       
        System.out.println("Graph Representations:");
        System.out.println("1. Adjacency Matrix");
        System.out.println("2. Adjacency List");
        System.out.println("3. Edge List\n");

        int vertices = 4;

      
        int[][] matrix = {
                {0,1,1,1},
                {1,0,1,1},
                {1,1,0,1},
                {1,1,1,0}
        };

        System.out.println("Adjacency Matrix:");

        for(int i=0; i<vertices; i++) {
            for(int j=0; j<vertices; j++) {
                System.out.print(matrix[i][j] + " ");
            }
            System.out.println();
        }

       
        ArrayList<ArrayList<Integer>> list = new ArrayList<>();

        for(int i=0; i<vertices; i++) {
            list.add(new ArrayList<>());
        }

        list.get(0).addAll(Arrays.asList(1,2,3));
        list.get(1).addAll(Arrays.asList(0,2,3));
        list.get(2).addAll(Arrays.asList(0,1,3));
        list.get(3).addAll(Arrays.asList(0,1,2));

        System.out.println("\nAdjacency List:");

        for(int i=0; i<vertices; i++) {
            System.out.println(i + " -> " + list.get(i));
        }
    }
}
